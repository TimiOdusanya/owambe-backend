<div class="content" style="font-family: Arial, sans-serif; line-height: 1.5;">
  <h2><%= subject %></h2>
  <p>Hi <%= guestName || "there" %>,</p>
  <p><%- body %></p>
  <% if (mediaItems && mediaItems.length) { %>
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 16px 0; width: 100%;">
      <% mediaItems.forEach(function (item) { %>
        <tr>
          <td style="padding: 12px 0; border-bottom: 1px solid #eeeeee;">
            <div style="font-weight: bold; margin-bottom: 8px;"><%= item.title %></div>
            <% if (item.links && item.links.length) { %>
              <% item.links.forEach(function (link) { %>
                <a
                  href="<%= link.url %>"
                  download="<%= link.filename || 'media' %>"
                  style="display: inline-block; background-color: #007bff; color: #ffffff; padding: 8px 16px; text-decoration: none; border-radius: 5px; margin: 0 8px 8px 0;"
                >
                  <%= link.label || "Download" %>
                </a>
              <% }) %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>
  <% } %>
  <% if (buttonLink) { %>
    <p style="margin-top: 20px;">
      <a href="<%= buttonLink %>" style="display: inline-block; background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
        <%= buttonText || "Open event media" %>
      </a>
    </p>
  <% } %>
  <p style="margin-top: 20px;">If you have any questions, feel free to contact us.</p>
</div>
